# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Spotify  (https://developer.spotify.com/dashboard)
# ---------------------------------------------------------------------------
# Uses Authorization Code + PKCE, so NO client secret is required.
SPOTIFY_CLIENT_ID=0fb955711a314255bda6f7e34935ca8f

# Must match a Redirect URI registered on your Spotify app EXACTLY.
# Spotify requires an explicit loopback IP here — "localhost" is rejected.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ---------------------------------------------------------------------------
# Strava  (https://www.strava.com/settings/api)
# ---------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava app settings have an "Authorization Callback Domain" field.
# Set that field to exactly: localhost
STRAVA_REDIRECT_URI=http://localhost:8899/exchange_token

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Where OAuth tokens are cached. Directory is gitignored.
RPG_TOKEN_DIR=.tokens
